{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ADMOB_DISABLE_ADS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "env": {
        "EXPO_PUBLIC_ADMOB_DISABLE_ADS": "true"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_ADMOB_DISABLE_ADS": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      },
      "ios": {}
    }
  }
}
